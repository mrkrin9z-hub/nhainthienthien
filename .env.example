# Supabase — bắt buộc khi chạy trên Cloudflare / production.
# Local không có service role thì app dùng file data/shop.json và lưu ảnh trong data/uploads.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Ký cookie đăng nhập nội bộ. Đổi trước khi đưa lên mạng. Tối thiểu 32 ký tự.
AUTH_SECRET=

# Ảnh khách lên Google Drive (ưu tiên nếu đủ 3 biến). Không có thì dùng Supabase Storage bucket order-originals.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Cron dọn danh sách file (không tự xóa). Chỉ cần nếu còn gọi route cũ.
LOVABLE_CRON_SECRET=
